Screen {
    background: #101315;
    color: #e7e1d5;
}

#root {
    layout: vertical;
    height: 100%;
}

#view-content {
    height: 1fr;
}

#traffic-view {
    layout: horizontal;
    height: 1fr;
}

.pane {
    border: round #465158;
    background: #171c20;
}

.pane.-active {
    border: round #d9a94f;
}

.pane-title {
    color: #9eb6bd;
    text-style: bold;
    padding: 0 1;
    margin: 0;
}

.pane-title.-active {
    color: #d9a94f;
}

#detail-tabs,
#admin-tabs {
    color: #a8ada7;
    padding: 0 1;
    margin: 0;
    border-bottom: solid #2f393e;
}

#main-pane {
    width: 2fr;
    min-width: 36;
}

#detail-pane {
    width: 1fr;
    min-width: 30;
}

#admin-pane {
    width: 1fr;
    height: 1fr;
    min-width: 24;
}

#requests {
    height: 1fr;
    background: #171c20;
}

#detail-scroll {
    height: 1fr;
    background: #11161a;
}

#admin-list {
    height: 1fr;
    border: none;
    padding: 0;
    background: #171c20;
}

#admin-list:focus {
    border: none;
    background: #171c20;
    background-tint: transparent;
}

#admin-list > .option-list--option {
    padding: 0 1;
}

#admin-list > .option-list--option-highlighted,
#admin-list:focus > .option-list--option-highlighted,
#requests > .datatable--cursor,
#requests:focus > .datatable--cursor {
    color: #101315;
    background: #d9a94f;
    text-style: bold;
}

#detail-body {
    padding: 0;
    margin: 0;
}

#status-pane {
    height: 2;
    border-top: solid #2f393e;
    background: #0c0f11;
}

#status-line {
    color: #d9a94f;
    text-style: bold;
    padding: 0 1;
    margin: 0;
}

#config-line {
    color: #a8ada7;
    padding: 0 1;
    margin: 0;
}
